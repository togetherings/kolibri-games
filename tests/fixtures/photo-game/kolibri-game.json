{
  "format": 1,
  "type": "free-play",
  "id": "org.example.photo-test",
  "version": "1.0.0",
  "title": "Photo test",
  "description": "A bare game for testing the photo-guess service. The real game is BeaconHunt.",
  "requires_platform": ">=0.2",
  "service": "photo-guess",
  "data": [{"name": "photo-packs"}],
  "photos": {
    "countries": "countries.json",
    "maps": [
      {"id": "world", "title": "The whole world", "scale_km": 1500},
      {"id": "africa", "title": "Africa", "scale_km": 600},
      {"id": "europe", "title": "Europe", "scale_km": 300}
    ],
    "weights": {"country": 1, "location": 2},
    "max_share": 0.5,
    "max_photo_ratio": 3
  },
  "scoring": {"label": "Points", "order": "desc", "counts": "best", "tiebreak": "seconds", "min": 0, "max": 10000},
  "settings": [
    {"key": "mode", "type": "choice", "label": "Guess", "default": "country",
     "choices": [{"value": "country", "label": "The country"}, {"value": "location", "label": "The place"}]},
    {"key": "map", "type": "photo_map", "label": "Map", "default": "world"},
    {"key": "rounds", "type": "integer", "label": "Rounds", "min": 1, "max": 10, "default": 3}
  ]
}
